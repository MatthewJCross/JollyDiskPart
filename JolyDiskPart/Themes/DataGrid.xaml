<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataGrid -->
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#20252D"/>
        <Setter Property="BorderBrush" Value="#343A42"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowBackground" Value="#20252D"/>
        <Setter Property="AlternatingRowBackground" Value="#242A33"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    </Style>

    <!-- Column Headers -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#272D36"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="BorderBrush" Value="#343A42"/>
    </Style>

    <!-- Cells -->
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- Rows -->
    <Style TargetType="DataGridRow">
        <Setter Property="Height" Value="44"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#20252D"/>
        <Setter Property="BorderBrush" Value="#343A42"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#2A303A"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#2F80ED"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>