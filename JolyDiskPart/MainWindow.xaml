<Window x:Class="JollyDiskPart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart"
        xmlns:controls="clr-namespace:JollyDiskPart.Controls"
        mc:Ignorable="d"
        Title="Jolly Disk Partition Manager" Width="1600" Height="950" WindowStartupLocation="CenterScreen" Background="#181C22">
    <DockPanel>

        <!-- Title Bar -->
        <Border DockPanel.Dock="Top" Height="52" Background="#20252D" BorderBrush="#343A42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="💽" FontSize="22"/>
                    <TextBlock Text="DiskPart Manager" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#20252D" Padding="12" BorderBrush="#343A42" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="⟳ Refresh" Width="140" Height="42" Margin="0,0,10,0"/>
                <Button Content="🖴 Rescan Disks" Width="160" Height="42" Margin="0,0,10,0"/>
                <Button Content="📄 Export Info" Width="150" Height="42"/>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Height="38" Background="#20252D" BorderBrush="#343A42" BorderThickness="1,1,1,0">
            <DockPanel>
                <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="#9CCB65" Text="✔ Ready"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Administrator"/>
                    <Separator Margin="12,0"/>
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Version 1.0.0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="320"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Partition Grid Placeholder -->
                <Border Grid.Row="0" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Partitions on Disk 0 (Samsung SSD 970 EVO 1TB)" FontSize="22" FontWeight="SemiBold" Foreground="#4EA1FF" Margin="0,0,0,15"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Partitions}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="#20252D" BorderThickness="0" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Partition" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="140"/>
                                <DataGridTextColumn Header="File System" Binding="{Binding FileSystem}" Width="140"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="140"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
                                <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="120"/>
                                <DataGridTextColumn Header="Free" Binding="{Binding Free}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Disk Map Placeholder -->
                <Border Grid.Row="1" Margin="0,15,0,0" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="15">
                    <!--<TextBlock Text="Disk Map" Foreground="#4EA1FF" FontSize="20"/>-->
                    <local:DiskMapControl Grid.Row="1" Margin="0,15,0,0"/>
                </Border>
            </Grid>

            <!-- RIGHT ACTION PANEL -->
            <Border Grid.Column="1" Margin="0,15,15,15" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="18" FontSize="24" FontWeight="SemiBold" Foreground="#4EA1FF" Text="Actions"/>
                    <ScrollViewer>
                        <StackPanel Margin="12">
                            <Expander Header="Partition Actions" IsExpanded="True">
                                <StackPanel>
                                    <Button Content="Create Partition" Margin="0,5"/>
                                    <Button Content="Delete Partition" Margin="0,5"/>
                                    <Button Content="Format Partition" Margin="0,5"/>
                                    <Button Content="Extend Partition" Margin="0,5"/>
                                    <Button Content="Shrink Partition" Margin="0,5"/>
                                    <Button Content="Move Partition" Margin="0,5"/>
                                    <Button Content="Change Drive Letter" Margin="0,5"/>
                                    <Button Content="Properties" Margin="0,5"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Disk Actions" Margin="0,15,0,0" IsExpanded="True">
                                <StackPanel>
                                    <Button Content="Initialize Disk" Margin="0,5"/>
                                    <Button Content="Clean Disk" Margin="0,5"/>
                                    <Button Content="Convert to GPT" Margin="0,5"/>
                                    <Button Content="Convert to MBR" Margin="0,5"/>
                                    <Button Content="Properties" Margin="0,5"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>    