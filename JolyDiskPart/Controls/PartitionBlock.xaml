<UserControl x:Class="JolyDiskPart.Controls.PartitionBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JolyDiskPart.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Border x:Name="Outer" Width="{Binding Width}" Height="82" Margin="2" Background="{Binding Colour}" BorderBrush="White" BorderThickness="1" CornerRadius="6">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
            <TextBlock Grid.Row="1" FontSize="12" Text="{Binding FileSystem}"/>
            <TextBlock Grid.Row="2" FontSize="12" Text="{Binding Size}"/>
            <TextBlock Grid.Row="3" FontSize="11" Text="{Binding Status}"/>
        </Grid>
    </Border>
</UserControl>
