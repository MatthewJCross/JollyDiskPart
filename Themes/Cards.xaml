<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style x:Key="PartitionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#2B313A"/>
        <Setter Property="BorderBrush" Value="#4A4F57"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Style.Triggers>
            
            <!-- Hover -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#4EA1FF"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>

            <!-- Selected -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#4EA1FF"/>
                <Setter Property="BorderThickness" Value="3"/>
                <Setter Property="Background" Value="#313A47"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
</ResourceDictionary>