<UserControl x:Class="JollyDiskPart.Controls.DiskMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JollyDiskPart.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="DiskBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4A4F57"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Mouse hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4EA1FF"/>
                </Trigger>
                <!-- Selected disk -->
                <DataTrigger Binding="{Binding Disk.IsSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="BorderBrush" Value="#2E9BFF"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2E9BFF" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="PartitionBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Mouse hover -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                </Trigger>
                <!-- Selected -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#2E9BFF"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2E9BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent" Margin="0,0,0,15" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Disk information -->
        <Border Grid.Column="0" Margin="0,0,10,0" Padding="10" Background="#2B313A" CornerRadius="6" Style="{StaticResource DiskBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Disk.Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="48" Height="48" Margin="0,0,4,8"/>
                <StackPanel>
                    <TextBlock Text="{Binding Disk.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Disk.Model, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#CCCCCC"/>
                    <TextBlock Text="{Binding Disk.SizeGB, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Disk.SizeGB, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Uninitialised">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Disk.Status, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="#CCCCCC"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Partition map -->
        <Grid x:Name="PartitionGrid" Grid.Column="1" ClipToBounds="True"/>
    </Grid>
</UserControl>
