<UserControl x:Class="JollyDiskPart.Controls.PartitionResizeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:JollyDiskPart.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding UsedWidth}"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="{Binding FreeWidth}"/>
        </Grid.ColumnDefinitions>

        <!-- Partition -->
        <Border Grid.Column="0" Background="SteelBlue" Height="60">
            <TextBlock Text="{Binding PartitionName}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Drag Handle -->
        <Border Grid.Column="1" Background="Black" Cursor="SizeWE" MouseLeftButtonDown="Handle_MouseDown" MouseMove="Handle_MouseMove" MouseLeftButtonUp="Handle_MouseUp"/>

        <!-- Free --> 
        <Border Grid.Column="2" Background="LightGray" Height="60">
            <TextBlock Text="Free" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
