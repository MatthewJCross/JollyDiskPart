<Window x:Class="JollyDiskPart.Dialogs.ShrinkPartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart.Dialogs"
        mc:Ignorable="d"
        Title="Shrink Partition" Height="180" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Shrink amount (MB)" />
        <TextBox Grid.Row="1" Margin="0,8,0,10" Text="{Binding SizeMB, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Shrink" Width="80" Margin="5" IsDefault="True" Click="Shrink_Click" Style="{StaticResource RoundButton}"/>
            <Button Content="Cancel" Width="80" Margin="5" IsCancel="True" Style="{StaticResource RoundButton}"/>
        </StackPanel>
    </Grid>
</Window>
