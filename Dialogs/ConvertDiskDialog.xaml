<Window x:Class="JollyDiskPart.ViewModels.ConvertDiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="240" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Partition Style" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="5" Content="{Binding ButtonText}" IsDefault="True" Click="Convert_Click"/>
            <Button Width="90" Margin="5" Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
