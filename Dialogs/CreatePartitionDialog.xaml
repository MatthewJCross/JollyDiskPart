<Window x:Class="JollyDiskPart.Dialogs.CreatePartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart.Dialogs"
        mc:Ignorable="d"
        Title="Create Partition" Height="440" Width="560" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="15"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Create Partition"/>

        <!-- Preview -->
        <Border Grid.Row="1" Margin="0,15,0,0" BorderBrush="#C5C5C5" BorderThickness="1" CornerRadius="5">
            <Grid Margin="10">
                <Rectangle RadiusX="4" RadiusY="4" Fill="#2F80ED" Height="18" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <!-- Label -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Partition Label"/>
            <TextBox Grid.Column="1" Text="{Binding Label}"/>
        </Grid>

        <!-- Drive -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Drive Letter"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableDriveLetters}" SelectedItem="{Binding DriveLetter}"/>
        </Grid>

        <!-- File System -->
        <Grid Grid.Row="7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="File System"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding FileSystems}" SelectedItem="{Binding FileSystem}"/>
        </Grid>

        <!-- Size -->
        <Grid Grid.Row="9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Size (MB)" Margin="0,10,0,0"/>
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Size (MB)" Margin="0,4,0,0"/>
                    <TextBox Margin="4,4,0,0" Width="180" Text="{Binding SizeMB, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseMaximumSpace, Converter={StaticResource InverseBooleanConverter}}" />
                    <CheckBox Margin="10,6,0,0" Content="Use Maximum Space" IsChecked="{Binding UseMaximumSpace, Mode=TwoWay}"/>
                </StackPanel>

                <Slider Margin="0,12,0,0" Minimum="1" Maximum="{Binding MaxSizeMB}" Value="{Binding SizeMB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="Gray" Text="{Binding SizeDisplay}"/>
            </StackPanel>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="11">
            <CheckBox Margin="0,5" Content="Quick Format" IsChecked="{Binding QuickFormat}"/>
            <CheckBox Margin="0,5" Content="Primary Partition" IsChecked="{Binding IsPrimary}"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" VerticalAlignment="Bottom" Style="{StaticResource RoundButton}"/>
            <Button Width="90" Content="Create" IsDefault="True" Command="{Binding CreateCommand}" VerticalAlignment="Bottom" Style="{StaticResource RoundButton}"/>
        </StackPanel>
    </Grid>
</Window>
