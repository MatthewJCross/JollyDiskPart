<Window x:Class="JollyDiskPart.Dialogs.MovePartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart.Dialogs"
        mc:Ignorable="d"
        Title="Move Partition" Height="300" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Move Partition" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Current position:" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CurrentPositionDisplay}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="New position:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding NewOffsetMB, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="Gray" Text="{Binding RangeDisplay, StringFormat=Allowed range: {0}}"/>
        <CheckBox Grid.Row="4" Margin="0,16,0,0" Content="Verify data after copying" IsChecked="{Binding VerifyAfterCopy}"/>
        <TextBlock Grid.Row="5" Margin="0,20,0,10" TextWrapping="Wrap" Text="Moving a partition can take some time. Do not interrupt the operation while the partition is being moved."/>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,10,0" IsCancel="True" Style="{StaticResource RoundButton}"/>
            <Button Content="Move" Width="90" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Move_Click" Style="{StaticResource RoundButton}"/>
        </StackPanel>
    </Grid>
</Window>
