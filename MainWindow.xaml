<Window x:Class="JollyDiskPart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollyDiskPart"
        xmlns:controls="clr-namespace:JollyDiskPart.Controls"
        mc:Ignorable="d"
        Title="Jolly Disk Partition Manager" Width="1600" Height="950" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#181C22">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" />
    </WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Close" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Maximize" />
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Minimize" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" CanExecute="CommandBinding_CanExecute" Executed="CommandBinding_Executed_Restore" />
    </Window.CommandBindings>

    <DockPanel>

        <!-- Title Bar -->
        <Border DockPanel.Dock="Top" Height="52" Background="#20252D" BorderBrush="#343A42" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <Image Source="/Resources/DiskPart.png"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource MinimizeButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize" Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                    <Button x:Name="RestoreButton" Visibility="Collapsed" Style="{StaticResource RestoreButtonStyle}" Command="{x:Static SystemCommands.RestoreWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Restore"/>
                    <Button x:Name="MaximizeButton" Visibility="Visible" Style="{StaticResource MaximizeButtonStyle}" Command="{x:Static SystemCommands.MaximizeWindowCommand}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseButtonStyle}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#20252D" Padding="12" BorderBrush="#343A42" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshDisksCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="34" Foreground="#2E9BFF" Margin="0,0,12,0"/>
                        <TextBlock Text="Refresh" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding RescanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣" FontSize="30" Foreground="#BFC7D5" Margin="0,0,12,0"/>
                        <TextBlock Text="Rescan Disks" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▤" FontSize="30" Foreground="#BFC7D5" Margin="0,0,12,0"/>
                        <TextBlock Text="Export Info" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Height="38" Background="#20252D" BorderBrush="#343A42" BorderThickness="1,1,1,0">
            <DockPanel LastChildFill="False">
                
                <!-- Left status -->
                <TextBlock DockPanel.Dock="Left" Margin="12,0" VerticalAlignment="Center" Foreground="#9CCB65" Text="{Binding StatusMessage}"/>

                <!-- Progress -->
                <ProgressBar DockPanel.Dock="Left" Width="180" Height="14" Margin="15,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>

                <!-- Right status -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0">
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Administrator"/>
                    <Separator Margin="12,0"/>
                    <TextBlock Foreground="White" VerticalAlignment="Center" Text="Version 1.0.0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="320"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Partition Grid -->
                <Border Grid.Row="0" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#4EA1FF" Text="{Binding SelectedDiskDisplayName}"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedDisk.Partitions}" SelectedItem="{Binding SelectedPartition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" Background="#20252D" BorderThickness="0" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Partition" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="24" Height="24" Source="{Binding PartitionIcon, Mode=OneWay}"/>
                                                <TextBlock Text="{Binding DriveLetterDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="#4EA1FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="140" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="File System" Binding="{Binding FileSystemDisplay, Mode=OneWay}" Width="140" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding LabelDisplay, Mode=OneWay}" Width="140" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding Size, Mode=OneWay}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="Used" Binding="{Binding UsedDisplay, Mode=OneWay}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="Free" Binding="{Binding FreeDisplay, Mode=OneWay}" Width="120" ElementStyle="{StaticResource CenteredTextStyle}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="*" ElementStyle="{StaticResource CenteredTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Disk Map -->
                <Border Grid.Row="1" Margin="0,15,0,0" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Disk Map" FontSize="22" FontWeight="SemiBold" Foreground="#4EA1FF" Margin="0,0,0,15"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Disks}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DiskMapControl Disk="{Binding}" DiskSelectionRequested="DiskMapControl_DiskSelectionRequested" SelectedDisk="{Binding DataContext.SelectedDisk, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" SelectedPartition="{Binding DataContext.SelectedPartition, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT ACTION PANEL -->
            <Border Grid.Column="1" Margin="0,15,15,15" Background="#20252D" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="18" FontSize="24" FontWeight="SemiBold" Foreground="#4EA1FF" Text="Actions"/>
                        <StackPanel Margin="12">
                            <Expander Header="Partition Actions" IsExpanded="True" Foreground="White">
                                <StackPanel Margin="0,5">
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding CreatePartitionCommand}" IsEnabled="{Binding CanCreatePartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Create.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Create Partition" VerticalAlignment="Center" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding DeletePartitionCommand}" IsEnabled="{Binding CanDeletePartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Delete.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Delete Partition" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding FormatPartitionCommand}" IsEnabled="{Binding CanFormatPartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Format.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Format Partition" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ExtendPartitionCommand}" IsEnabled="{Binding CanExtendPartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Extend.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Extend Partition" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ShrinkPartitionCommand}" IsEnabled="{Binding CanShrinkPartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Shrink.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Shrink Partition" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding MovePartitionCommand}" IsEnabled="{Binding CanMovePartition}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Move.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Move Partition" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ChangeDriveLetterCommand}" IsEnabled="{Binding CanChangeDriveLetter}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Change.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Change Drive Letter" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding CanShowProperties}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Properties.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Properties" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                        <Expander Header="Disk Actions" Margin="0,15,0,0" IsExpanded="True" Foreground="White">
                                <StackPanel Margin="0,5">
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding InitialiseDiskCommand}" IsEnabled="{Binding CanInitializeDisk}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Initialise.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Initialize Disk" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding CleanDiskCommand}" IsEnabled="{Binding CanCleanDisk}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Clean.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Clean Disk" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ConvertToGptCommand}" IsEnabled="{Binding CanConvertToGpt}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/GPT.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Convert to GPT" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding ConvertToMbrCommand}" IsEnabled="{Binding CanConvertToMbr}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/MBR.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Convert to MBR" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding TakeDiskOfflineCommand}" IsEnabled="{Binding CanTakeOffline}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Offline.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Offline" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionButtonStyle}" Command="{Binding BringDiskOnlineCommand}" IsEnabled="{Binding CanBringOnline}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="/Resources/Online.png" Margin="0,0,10,0" Width="24" Height="24"/>
                                            <TextBlock Text="Online" FontSize="14"/>
                                        </StackPanel>
                                    </Button>
                            </StackPanel>
                            </Expander>
                        </StackPanel>
                </DockPanel>
            </Border>

            <!-- Busy Overlay -->
            <Grid Background="#AA000000" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" Panel.ZIndex="9999">
                <Border Width="300" Height="220" CornerRadius="10" Background="#2B313A" BorderBrush="#4EA1FF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <controls:BusySpinner Width="70" Height="70" Margin="0,25,0,15" HorizontalAlignment="Center"/>
                        <TextBlock Text="Scanning disks..." FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Reading partitions, volumes and hardware..." Margin="0,12,0,0" FontSize="13" Foreground="#BBBBBB" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
